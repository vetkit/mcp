{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.vetkit/mcp",
  "title": "vetkit",
  "description": "Audit repos for security, code quality and AI code risks; read findings and open fix PRs.",
  "websiteUrl": "https://vetkit.dev/en/docs/mcp/",
  "version": "0.3.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@vetkit/mcp",
      "version": "0.3.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "VETKIT_API_KEY",
          "description": "vetkit API key from app.vetkit.dev/settings/api-keys",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "VETKIT_ORG_ID",
          "description": "Organization ID, only needed when the key can access several organizations",
          "isRequired": false,
          "format": "string"
        }
      ]
    }
  ]
}
